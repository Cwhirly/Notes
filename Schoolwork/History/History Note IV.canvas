		{"id":"c6731d339dec827b","type":"text","text":"+ 公民（成年男性）\n+ 非公民（外邦人和奴隶）","x":9341,"y":677,"width":281,"height":78},
		{"id":"04ab0387f9f4f2be","type":"text","text":"### 西罗马帝国","x":9641,"y":962,"width":180,"height":60,"color":"6"},
